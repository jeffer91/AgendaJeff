{
  "name": "agendajeff",
  "version": "1.0.0",
  "description": "AgendaJeff - App personal de agenda, carga masiva, conexiones y notificaciones.",
  "main": "electron/main.js",
  "author": "Jefferson Villarreal",
  "license": "MIT",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "electron": "electron .",
    "dev": "electron .",
    "check": "node -e \"console.log('AgendaJeff lista para Electron')\""
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "^31.0.0"
  },
  "build": {
    "appId": "com.jeffersonvillarreal.agendajeff",
    "productName": "AgendaJeff",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "menu/**/*",
      "electron/**/*",
      "Agendador/**/*",
      "carga-masiva/**/*",
      "google-calendar/**/*",
      "microsoft-calendar/**/*",
      "telegram/**/*",
      "notificaciones-desktop/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    }
  }
}