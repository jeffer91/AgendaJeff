{
  "name": "agenda-jeff",
  "version": "0.0.1",
  "description": "AgendaJeff - reconstrucción modular desde cero.",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "check": "node scripts/aj-check.js",
    "version:bump": "node scripts/version/aj-version-bump.js patch",
    "version:minor": "node scripts/version/aj-version-bump.js minor",
    "version:major": "node scripts/version/aj-version-bump.js major",
    "release:prepare": "node scripts/release/aj-release-prepare.js",
    "build:guard": "node scripts/build/aj-build-guard.js",
    "build:win": "npm run build:guard && electron-builder --win nsis",
    "release:win": "scripts\\windows\\aj-release.bat patch",
    "android:prepare": "node scripts/android/aj-android-prepare.js",
    "android:check": "node scripts/android/aj-android-check.js",
    "android:sync": "npm run android:prepare && npx cap sync android",
    "android:open": "npm run android:sync && npx cap open android",
    "android:apk": "scripts\\windows\\aj-android-apk.bat"
  },
  "keywords": [
    "agenda",
    "electron",
    "modular",
    "android",
    "capacitor"
  ],
  "author": "Jefferson Villarreal",
  "license": "MIT",
  "build": {
    "appId": "com.agendajeff.app",
    "productName": "AgendaJeff",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "electron/**/*",
      "core/**/*",
      "modulos/**/*",
      "release/agenda-jeff-version.json",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "artifactName": "AgendaJeff-Setup-${version}.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AgendaJeff"
    }
  },
  "agendaJeff": {
    "nombreCompleto": "package.json",
    "ruta": "package.json",
    "funcion": "Define el proyecto Electron, scripts de ejecución, verificación, versionado, build y preparación Android para AgendaJeff.",
    "seConectaCon": [
      "electron/main.js",
      "index.html",
      "scripts/aj-check.js",
      "scripts/version/aj-version-bump.js",
      "scripts/release/aj-release-prepare.js",
      "scripts/windows/aj-release.bat",
      "scripts/android/aj-android-prepare.js",
      "scripts/windows/aj-android-apk.bat",
      "capacitor.config.json"
    ],
    "nota": "JSON no permite comentarios. Por eso esta metadata queda dentro de agendaJeff para conservar el archivo válido."
  },
  "dependencies": {
    "@capacitor/android": "^6.1.2",
    "@capacitor/core": "^6.1.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.1.2",
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  }
}
